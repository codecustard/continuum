{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codecustard/continuum/manifest/schema.json",
  "title": "Continuum game manifest v0",
  "description": "Describes a registered package: what it makes, what it reads, what its slot fields mean, and the license for its art and data. Its hash is stored in continuum::registry.",
  "type": "object",
  "required": ["version", "name", "package", "types", "license"],
  "properties": {
    "version": { "const": 0 },
    "name": { "type": "string", "description": "Display name. Not trusted: trust follows the package ID." },
    "package": { "type": "string", "pattern": "^0x[0-9a-f]{64}$", "description": "Original package ID; must match the registry key." },
    "description": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "source": { "type": "string", "format": "uri", "description": "Source repository." },
    "types": {
      "type": "array",
      "description": "Object types this package defines.",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "description": "module::Struct" },
          "open_slots": { "type": "boolean", "description": "Exposes uid_mut for other games' slots." },
          "fields": { "$ref": "#/$defs/fields" }
        }
      }
    },
    "slots": {
      "type": "array",
      "description": "Slots this package attaches to other games' objects.",
      "items": {
        "type": "object",
        "required": ["key", "on"],
        "properties": {
          "key": { "type": "string", "description": "module::KeyStruct (no public constructor)." },
          "on": { "type": "string", "description": "Full type the slot attaches to, 0x…::module::Struct." },
          "fields": { "$ref": "#/$defs/fields" }
        }
      }
    },
    "reads": {
      "type": "array",
      "description": "Outside types or CAIP-19 collections this package reads or derives from.",
      "items": { "type": "string" }
    },
    "witness": { "type": "string", "description": "module::Witness used with continuum::provenance." },
    "license": {
      "type": "object",
      "required": ["art", "data"],
      "properties": {
        "art": { "type": "string", "description": "SPDX ID or URL, e.g. CC0-1.0." },
        "data": { "type": "string", "description": "SPDX ID or URL for on-chain fields and state." }
      }
    }
  },
  "$defs": {
    "fields": {
      "type": "object",
      "description": "Field name → meaning.",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "meaning": { "type": "string" },
          "range": { "type": "string" }
        }
      }
    }
  }
}
